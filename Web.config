<security>
    <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="4294967295" maxUrl="1048576" maxQueryString="1048576" />
        <fileExtensions allowUnlisted="true">
            <clear />
        </fileExtensions>
        <hiddenSegments>
            <remove segment="bin" />
        </hiddenSegments>
    </requestFiltering>
</security>
